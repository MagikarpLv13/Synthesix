{
  "manifest_version": 3,
  "name": "Synthesix",
  "version": "0.1.0",
  "description": "Local Synthesix helper extension for http and https pages.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "dist/background-ca5203a8cd0ecdf5.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://lens.google.com/*",
        "https://maps.google.com/*",
        "https://www.google.com/maps*"
      ],
      "js": [
        "dist/focus-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://lens.google.com/*",
        "https://maps.google.com/*",
        "https://www.google.com/maps*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/overlay-main.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
